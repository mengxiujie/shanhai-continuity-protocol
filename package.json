{
  "name": "shanhai-continuity-protocol-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "dependencies": { "ethers": "6.17.0" },
  "scripts": {
    "test": "npm run test:protocol && npm run test:monad-gate && npm run test:wallet",
    "test:protocol": "npm --prefix protocol test",
    "test:process": "npm --prefix protocol run test:process",
    "test:sprint": "node --test --test-isolation=none protocol/test/e2e/sprint-chain.test.mjs",
    "test:wallet": "node --test --test-isolation=none deployment/test/wallet-workbench.test.mjs",
    "sprint:wallet": "node deployment/wallet-workbench.mjs",
    "test:monad-gate": "node --test --test-isolation=none apps/demo/test/monad-gate.test.mjs",
    "compile:contract": "npm --prefix contracts run compile",
    "audit:release": "node scripts/release-audit.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "audit:hosting": "node scripts/audit-hosting.mjs",
    "probe:monad": "node apps/demo/probe-monad-rpc.mjs",
    "verify:deployment": "node deployment/verify-deployment.mjs",
    "serve:demo": "python -m http.server 4173"
  }
}
